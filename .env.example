# 카카오 REST API 키. 서버(/api/restaurants 라우트)에서만 사용되며 브라우저에 노출되지 않습니다.
# 로컬: .dev.vars 에 넣고, 배포: `wrangler secret put KAKAO_REST_API_KEY`
KAKAO_REST_API_KEY=

# 카카오맵 Web(JavaScript) SDK용 JavaScript 키입니다. REST API 키와 다릅니다.
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=

# Firebase Web App config (브라우저에 노출되는 공개 설정값)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase ID Token 검증에 사용되는 Worker 환경값
# FIREBASE_PROJECT_ID는 vite.config.ts vars에 설정
# APP_ORIGIN은 vite.config.ts vars에 설정

# 세션 서명용 secret. 로컬: .dev.vars 에 넣고, 배포: `wrangler secret put AUTH_SESSION_SECRET`
AUTH_SESSION_SECRET=
